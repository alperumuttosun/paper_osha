      html <- paste(clean_utf8(readLines(page_file, warn = FALSE)), collapse = " ")
      links <- regmatches(html, gregexpr("https?://[^\"' ]+\\.zip", html))[[1]]
      links <- unique(links[grepl("sites/default/files", links)])
      if (length(links) > 0) {
        dest <- file.path(raw_dir, basename(links[1]))
        if (get_file(links[1], dest, max_sec = 600)) sir_zip <- dest
