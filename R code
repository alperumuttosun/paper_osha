# ---------------- step07C/D : flexible simulation ----------------------------
# att  = share of the Michigan pattern that is kept (1 = as observed, 0 = equal reporting);
#        the logit of every reporting probability is pulled towards the pooled value
# disc = the Michigan sample is treated as disc times smaller (wider uncertainty)

sim_flex <- function(d, att = 1, disc = 1, B = B5) {
  n   <- nrow(d)
  cnt <- matrix(rgamma(B * n, shape = rep(d$count + 0.5, each = B), rate = 1), nrow = B)   # count noise
  p   <- matrix(rbeta(B * n, rep(d$mi_reported / disc + 0.5, each = B),
                      rep((d$mi_total - d$mi_reported) / disc + 0.5, each = B)), nrow = B)  # reporting
  p   <- pmin(pmax(p, 1e-4), 1 - 1e-4)                         # keep the logit finite
  p0  <- sum(d$mi_reported) / sum(d$mi_total)                  # pooled reporting probability
  p   <- plogis(qlogis(p0) + att * (qlogis(p) - qlogis(p0)))   # attenuated pattern
  list(d = d, p = p, wy = d$worker_years,
       rate = 1e5 * cnt / p / matrix(d$worker_years, B, n, byrow = TRUE))                    # corrected rate
}

# number of robust / uncertain / reversed pairs in one simulation
pair_counts <- function(s) {
  cr <- s$d$count / s$d$worker_years
  ord <- order(-cr); n <- length(ord); pf <- numeric(0)
  for (a in 1:(n - 1)) for (b in (a + 1):n) {
    i <- ord[a]; j <- ord[b]                                   # i has the higher reported rate
    pf <- c(pf, mean(s$p[, j] / s$p[, i] < cr[j] / cr[i]))     # probability of reversal
  }
  c(robust = sum(pf <= 0.05), uncertain = sum(pf > 0.05 & pf < 0.95), reversed = sum(pf >= 0.95))
}

