# ---------------- step04A : prior-free rank bounds ---------------------------
# Assumption: reporting probabilities of any two sectors differ by at most a factor g.
# Sector i is then surely above sector j only if crude_i / crude_j > g.

cr <- dat3$amp / dat3$worker_years                             # crude rates (not rounded)
names(cr) <- dat3$sector
g_grid <- c(1, 1.25, 1.5, 2, 3, 4, 5, 8)                       # heterogeneity factors

bounds <- rbindlist(lapply(g_grid, function(g) {
  best  <- sapply(seq_along(cr), function(i) 1 + sum(cr[-i] / cr[i] > g))        # best possible rank
  worst <- sapply(seq_along(cr), function(i) length(cr) - sum(cr[i] / cr[-i] > g)) # worst possible rank
  data.table(g = g, sector = names(cr), crude_rank = dat3$crude_rank,
             rank_best = best, rank_worst = worst, width = worst - best)
}))
bounds_wide <- dcast(bounds, sector + crude_rank ~ g,
                     value.var = "width")[order(crude_rank)]   # interval width by g

# smallest g at which each sector can lose its published-style rank
lose_rank <- data.table(sector = names(cr), crude_rank = dat3$crude_rank)
lose_rank[, g_to_move_up   := sapply(seq_along(cr), function(i) {
  above <- cr[cr > cr[i]]                                      # sectors ranked above
  if (length(above) == 0) NA_real_ else round(min(above / cr[i]), 3)
})]
lose_rank[, g_to_move_down := sapply(seq_along(cr), function(i) {
  below <- cr[cr < cr[i]]                                      # sectors ranked below
  if (length(below) == 0) NA_real_ else round(min(cr[i] / below), 3)
})]

# ---------------- step04B : pairwise tipping points --------------------------

min_cases <- 20                                                # Michigan cases needed per sector
dat4 <- dat3[mi_total >= min_cases]                            # sectors with usable evidence
message("step04B: sectors with >= ", min_cases, " Michigan cases: ",
        paste(dat4$sector, collapse = ", "))

set.seed(2026)                                                 # reproducible draws
B4 <- 20000
# Beta draws of the reporting probability (Jeffreys prior, Michigan counts only)
p4 <- sapply(seq_len(nrow(dat4)), function(i)
  rbeta(B4, dat4$mi_reported[i] + 0.5, dat4$mi_total[i] - dat4$mi_reported[i] + 0.5))
colnames(p4) <- dat4$sector
cr4 <- dat4$amp / dat4$worker_years                            # crude rates of these sectors

idx <- CJ(i = seq_len(nrow(dat4)), j = seq_len(nrow(dat4)))[i < j]   # i ranked above j
tipping <- idx[, {
  ratio_draw <- p4[, j] / p4[, i]                              # reporting ratio lower/higher
  thr <- cr4[j] / cr4[i]                                       # flip happens below this value
  .(higher = dat4$sector[i], lower = dat4$sector[j],
    crude_rate_ratio = round(cr4[i] / cr4[j], 2),
    tipping_ratio    = round(thr, 3),
    michigan_ratio   = round(dat4$mi_compliance[j] / dat4$mi_compliance[i], 3),
    ratio_lo         = round(quantile(ratio_draw, 0.025), 3),
    ratio_hi         = round(quantile(ratio_draw, 0.975), 3),
    p_flip           = round(mean(ratio_draw < thr), 4))       # probability the order reverses
}, by = .(i, j)]
tipping[, c("i", "j") := NULL]
tipping[, verdict := ifelse(p_flip >= 0.95, "reversed",
                     ifelse(p_flip <= 0.05, "robust", "uncertain"))]
setorder(tipping, -p_flip)

# ---------------- step04C : Monte Carlo on the restricted sector set ---------

