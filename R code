# make any text valid UTF-8 (drops bytes that cannot be converted)
clean_utf8 <- function(x) {
  if (!is.character(x)) return(x)
  y <- iconv(x, from = "UTF-8", to = "UTF-8", sub = "")          # keep valid UTF-8
  bad <- is.na(y) & !is.na(x)                                     # strings that failed
  if (any(bad)) y[bad] <- iconv(x[bad], from = "latin1", to = "UTF-8", sub = "")
  y
}

# download a file: Option A = curl package (hard time limit), Option B = base R libcurl
get_file <- function(url, dest, max_sec = 90) {
  ok <- FALSE
  # Option A
  try({
    h <- curl::new_handle(useragent = UA, followlocation = TRUE,
                          timeout = max_sec, connecttimeout = 20)
    curl::curl_download(url, dest, handle = h, quiet = TRUE)
    ok <- file.exists(dest) && file.size(dest) > 0
  }, silent = TRUE)
  # Option B
  if (!ok) {
    try({
      suppressWarnings(
        download.file(url, dest, mode = "wb", method = "libcurl", quiet = TRUE,
                      headers = c("User-Agent" = UA)))
      ok <- file.exists(dest) && file.size(dest) > 0
    }, silent = TRUE)
  }
  if (!ok && file.exists(dest)) unlink(dest)      # remove empty/broken file
  ok
}

# standardise column names: lower case, only letters/digits/underscore
std_names <- function(x) {
  x <- clean_utf8(x)
  x <- tolower(gsub("[^A-Za-z0-9]+", "_", x))
  gsub("^_+|_+$", "", x)
}

# find the first column whose name matches a pattern (NA if none)
find_col <- function(nms, pattern) {
  hit <- grep(pattern, nms, value = TRUE)
  if (length(hit) == 0) NA_character_ else hit[1]
}

# parse dates written in different formats; keep the format that works best
parse_date_any <- function(x) {
  fmts <- c("%m/%d/%Y", "%Y-%m-%d", "%m/%d/%y", "%d-%b-%y", "%d-%b-%Y")
  best <- as.Date(rep(NA_character_, length(x)))
  for (f in fmts) {
    d <- suppressWarnings(as.Date(substr(x, 1, 10), format = f))
    if (sum(!is.na(d)) > sum(!is.na(best))) best <- d
  }
  best
}

# map a NAICS code to its 2-digit sector label (same labels as QCEW)
naics_sector <- function(code) {
  s <- substr(gsub("[^0-9]", "", as.character(code)), 1, 2)
  s[s %in% c("31", "32", "33")] <- "31-33"
  s[s %in% c("44", "45")]       <- "44-45"
  s[s %in% c("48", "49")]       <- "48-49"
  s[!nzchar(s) | is.na(s)]      <- NA_character_
  s
}

# write the summary: Option A = one Excel file, Option B = one csv per sheet
xlsx_file <- file.path(out_dir, "step01_summary.xlsx")
write_summary <- function(sheets, file = xlsx_file, prefix = "step01_") {
  ok <- tryCatch({
    openxlsx::write.xlsx(sheets, file, overwrite = TRUE)          # same file is overwritten
    TRUE
  }, error = function(e) FALSE)
  if (!ok) {
    for (nm in names(sheets)) {
      fwrite(sheets[[nm]], file.path(out_dir, paste0(prefix, nm, ".csv")), bom = TRUE)
    }
  }
  ok
}

