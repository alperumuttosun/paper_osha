# counts + exposure + Michigan counts for one outcome
build_dat <- function(col, mich_tab) {
  num <- sir3[, .(count = sum(get(col))), by = sector]                     # reported cases
  d <- merge(merge(num, den3, by = "sector"), mich_tab, by = "sector")     # den3 = exposure without mines
  d[, crude_rate := 1e5 * count / worker_years]                            # reported rate
  d[, crude_rank_all := frank(-crude_rate, ties.method = "min")]           # rank among all 19 sectors
  d[, mi_compliance := ifelse(mi_total > 0, round(mi_reported / mi_total, 3), NA_real_)]  # Michigan compliance
