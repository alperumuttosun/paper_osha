# ---------------- step03B : Monte Carlo --------------------------------------

B <- 20000                                                     # number of simulation draws

# rank every row of a matrix (1 = highest rate): Option A = apply, Option B = plain loop
row_ranks <- function(m) {
  out <- tryCatch(t(apply(-m, 1, rank, ties.method = "min")), error = function(e) NULL)
  if (is.null(out) || !all(dim(out) == dim(m))) {
    out <- matrix(NA_real_, nrow(m), ncol(m))
    for (r in seq_len(nrow(m))) out[r, ] <- rank(-m[r, ], ties.method = "min")
  }
  out
}

# one scenario: mode "equal" = same reporting everywhere; "beta" = Michigan-based
# k    = weight of the pooled prior (in pseudo-cases)
# disc = discount on the Michigan information (1 = as is, 4 = four times weaker)
run_mc <- function(mode, k = 2, disc = 1) {
  lam <- matrix(rgamma(B * n_sec, shape = rep(dat3$amp + 0.5, each = B), rate = 1),
                nrow = B)                                      # sampling noise of the counts
  if (mode == "equal") {
    p <- matrix(m0, B, n_sec)                                  # one reporting probability
  } else {
    a <- m0 * k + dat3$mi_reported / disc                      # Beta parameters per sector
    b <- (1 - m0) * k + (dat3$mi_total - dat3$mi_reported) / disc
    p <- matrix(rbeta(B * n_sec, rep(a, each = B), rep(b, each = B)), nrow = B)
    p <- pmax(p, 0.01)                                         # avoid division by ~0
  }
  rate <- 1e5 * lam / p / matrix(dat3$worker_years, B, n_sec, byrow = TRUE)   # corrected rate
  list(rate = rate, rank = row_ranks(rate), p = p)
}

# summary table of one scenario
summ_mc <- function(mc, label) {
  data.table(
    scenario   = label,
    sector     = dat3$sector,
    crude_rank = dat3$crude_rank,
    rank_med   = apply(mc$rank, 2, median),                    # typical rank
    rank_lo    = apply(mc$rank, 2, quantile, 0.025),           # 95% rank interval
    rank_hi    = apply(mc$rank, 2, quantile, 0.975),
    p_first    = round(colMeans(mc$rank == 1), 4),             # probability of being most dangerous
    p_top3     = round(colMeans(mc$rank <= 3), 4),
    p_top5     = round(colMeans(mc$rank <= 5), 4),
    rate_med   = round(apply(mc$rate, 2, median), 2),          # corrected rate
    rate_lo    = round(apply(mc$rate, 2, quantile, 0.025), 2),
    rate_hi    = round(apply(mc$rate, 2, quantile, 0.975), 2),
    p_med      = round(apply(mc$p, 2, median), 3))             # reporting probability used
}

