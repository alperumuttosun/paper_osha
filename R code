B8 <- 20000

# draws of counts and exposure for the sectors in d under one model
draw_counts <- function(d, Cm, model, B = B8) {
  n <- nrow(d); idx <- match(d$sector, secs8)
  expo <- matrix(d$worker_years, B, n, byrow = TRUE)
  if (model == "poisson") {
    cnt <- matrix(rgamma(B * n, shape = rep(d$count + 0.5, each = B), rate = 1), nrow = B)
  } else if (model == "overdispersed") {
    phi <- pmax(1, d$phi)                                       # never narrower than Poisson
    cnt <- matrix(rgamma(B * n, shape = rep((d$count + 0.5) / phi, each = B),
                         rate = rep(1 / phi, each = B)), nrow = B)   # variance = phi x mean
  } else {                                                      # years resampled with replacement
    W    <- t(rmultinom(B, n_yr, rep(1 / n_yr, n_yr)))          # how often each year is drawn
    cnt  <- W %*% t(Cm[idx, , drop = FALSE])
    expo <- W %*% t(Emat[idx, , drop = FALSE])
  }
  list(cnt = cnt, expo = expo)
}

