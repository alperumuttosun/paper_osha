  }

  # 3) Option B: fixed link (file that was online in November 2026)
  if (is.na(sir_zip)) {
    url_fixed <- "https://www.osha.gov/sites/default/files/January2015toNovember2025.zip"
    dest <- file.path(raw_dir, basename(url_fixed))
    if (get_file(url_fixed, dest, max_sec = 600)) sir_zip <- dest
  }

  # 4) last resort: tell the user what to do (no deleting needed)
  if (is.na(sir_zip)) {
    stop("SIR zip could not be downloaded automatically.\n",
         "Open https://www.osha.gov/severe-injury-reports in a browser, click\n",
         "'Download the full SIR data set' and put the zip file into:\n  ", raw_dir,
         "\nThen run the script again.")
  }
  message("step01A: using ", basename(sir_zip))

  # unzip into a sub-folder and pick the largest csv inside
  unz_dir <- file.path(raw_dir, "sir_unzipped")
  if (!dir.exists(unz_dir)) dir.create(unz_dir)
  unzip(sir_zip, exdir = unz_dir, overwrite = TRUE)
  csvs <- list.files(unz_dir, pattern = "\\.csv$", full.names = TRUE,
                     recursive = TRUE, ignore.case = TRUE)
  if (length(csvs) == 0) stop("No csv file found inside the SIR zip.")
  sir_csv <- csvs[which.max(file.size(csvs))]

  # read the csv: Option A = fread directly, Option B = read as latin1 text first
  sir <- tryCatch(
    fread(sir_csv, encoding = "UTF-8", colClasses = "character",
          fill = TRUE, showProgress = FALSE),
    error = function(e) NULL)
  if (is.null(sir) || nrow(sir) < 1000) {
    con <- file(sir_csv, open = "rb")
    txt <- readLines(con, warn = FALSE, encoding = "latin1")     # raw text lines
    close(con)
    txt <- iconv(txt, from = "latin1", to = "UTF-8", sub = "")   # force valid UTF-8
    sir <- fread(text = paste(txt, collapse = "\n"), colClasses = "character",
                 fill = TRUE, showProgress = FALSE)
  }

  # tidy names and text
  setnames(sir, std_names(names(sir)))
  chr_cols <- names(sir)[vapply(sir, is.character, logical(1))]
  for (cc in chr_cols) set(sir, j = cc, value = clean_utf8(sir[[cc]]))

  # locate the key columns by name pattern (robust to small name changes)
  nms <- names(sir)
  col_date  <- find_col(nms, "event_?date|^date")
  col_state <- find_col(nms, "^state$")
  col_naics <- find_col(nms, "naics")
  col_hosp  <- find_col(nms, "hospital")
  col_amp   <- find_col(nms, "amputat")
  col_eye   <- find_col(nms, "eye")
  key_cols  <- c(date = col_date, state = col_state, naics = col_naics,
                 hosp = col_hosp, amp = col_amp)
  if (any(is.na(key_cols))) {
    stop("Key column(s) not found: ", paste(names(key_cols)[is.na(key_cols)], collapse = ", "),
         "\nColumns in file: ", paste(nms, collapse = ", "))
  }

  # derived analysis variables
  sir[, event_date   := parse_date_any(get(col_date))]                 # event date
  sir[, year         := as.integer(format(event_date, "%Y"))]          # calendar year
  sir[, state_std    := toupper(trimws(get(col_state)))]               # state name
  sir[, naics_code   := gsub("[^0-9]", "", get(col_naics))]            # digits only
  sir[, sector       := naics_sector(naics_code)]                      # 2-digit sector
  sir[, naics3       := ifelse(nchar(naics_code) >= 3, substr(naics_code, 1, 3), NA)]
  sir[, hospitalized := suppressWarnings(as.numeric(get(col_hosp)))]   # workers hospitalized
  sir[, amputation   := suppressWarnings(as.numeric(get(col_amp)))]    # workers with amputation
  if (!is.na(col_eye)) sir[, eye_loss := suppressWarnings(as.numeric(get(col_eye)))]
  sir[is.na(hospitalized), hospitalized := 0]
  sir[is.na(amputation),   amputation   := 0]
  sir[, any_amp  := as.integer(amputation   > 0)]                      # report has amputation
  sir[, any_hosp := as.integer(hospitalized > 0)]                      # report has hospitalization

  saveRDS(sir, sir_rds)                                                # cleaned data for later steps
  message("step01A: saved sir_clean.rds with ", nrow(sir), " rows")
}

