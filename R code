  }
  url <- sprintf("https://data.bls.gov/cew/data/api/%d/a/area/%s.csv", jobs$year[i], jobs$area[i])
  tmp <- tempfile(fileext = ".csv")
  ok  <- get_file(url, tmp)                                   # Option A then Option B inside
  st  <- "failed_download"
  if (ok) {
    q <- tryCatch(fread(tmp, colClasses = "character", showProgress = FALSE),
