  flush.console()

  # stop wasting time: 3 failures in a row -> skip the rest of that year
  fail_run <- if (st == "downloaded") 0 else fail_run + 1
  if (fail_run >= 3) {
    skip_year <- c(skip_year, jobs$year[i]); fail_run <- 0
    message("  -> 3 failures in a row: rest of ", jobs$year[i], " skipped")
  }
  # server not reachable at all: 3 different years failed and nothing downloaded
  if (length(skip_year) >= 3 && !any(jobs$status == "downloaded")) {
    message("  -> BLS server not reachable now; QCEW download stopped (re-run later)")
    break
  }
  Sys.sleep(0.2)                                              # be polite to the server
}

