# simulation with the hierarchical posterior Beta(r + a, n - r + b)
sim_eb <- function(d, B = B5) {
  f <- bb_fit(d$mi_reported, d$mi_total); n <- nrow(d)
  cnt <- matrix(rgamma(B * n, shape = rep(d$count + 0.5, each = B), rate = 1), nrow = B)
  p   <- matrix(rbeta(B * n, rep(d$mi_reported + f$a, each = B),
                      rep(d$mi_total - d$mi_reported + f$b, each = B)), nrow = B)
  list(d = d, p = p, wy = d$worker_years,
       rate = 1e5 * cnt / p / matrix(d$worker_years, B, n, byrow = TRUE))
}
