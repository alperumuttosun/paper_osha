# best and worst possible rank when reporting probabilities differ by at most a factor g
rank_bounds <- function(cr, g) {
  best  <- sapply(seq_along(cr), function(i) 1 + sum(cr[-i] / cr[i] > g))
  worst <- sapply(seq_along(cr), function(i) length(cr) - sum(cr[i] / cr[-i] > g))
  data.table(g = g, sector = names(cr), rank_best = best, rank_worst = worst)
}
