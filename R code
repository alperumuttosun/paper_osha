dat_hosp <- build_dat("hosp_only", mich_h)                     # outcome 2: hospitalizations

# ---------------- step05B : generic analysis ---------------------------------

B5 <- 20000                                                    # simulation draws
min_cases5 <- 20                                               # Michigan cases needed per sector

# Monte Carlo for one outcome; ag_mult multiplies the agricultural exposure
sim_outcome <- function(d_all, ag_mult = 1) {
  d <- d_all[mi_total >= min_cases5]                           # sectors with usable evidence
  n <- nrow(d)
  wy <- d$worker_years
  wy[d$sector == "11"] <- wy[d$sector == "11"] * ag_mult       # agriculture exposure scenario
  lam <- matrix(rgamma(B5 * n, shape = rep(d$count + 0.5, each = B5), rate = 1), nrow = B5)
  p   <- matrix(rbeta(B5 * n, rep(d$mi_reported + 0.5, each = B5),
                      rep(d$mi_total - d$mi_reported + 0.5, each = B5)), nrow = B5)
  p_eq <- sum(d$mi_reported) / sum(d$mi_total)                 # one common reporting probability
  wy_m <- matrix(wy, B5, n, byrow = TRUE)
  list(d = d, p = p, wy = wy,
       rate0 = 1e5 * lam / p_eq / wy_m,                        # equal reporting
       rate1 = 1e5 * lam / p    / wy_m)                        # Michigan reporting
}

# rank summary for one simulated rate matrix
summ_rank <- function(sim, rate, outcome, scenario) {
  rk <- row_ranks(rate)
  cr <- sim$d$count / sim$wy
  data.table(outcome = outcome, scenario = scenario, sector = sim$d$sector,
             crude_rank = frank(-cr, ties.method = "min"),     # rank among the kept sectors
             rank_med = apply(rk, 2, median),
             rank_lo  = apply(rk, 2, quantile, 0.025),
             rank_hi  = apply(rk, 2, quantile, 0.975),
             p_first  = round(colMeans(rk == 1), 4),
             p_top3   = round(colMeans(rk <= 3), 4),
             rate_med = round(apply(rate, 2, median), 2),
             rate_lo  = round(apply(rate, 2, quantile, 0.025), 2),
             rate_hi  = round(apply(rate, 2, quantile, 0.975), 2))
}

# pairwise tipping points for one outcome
tip_outcome <- function(sim, outcome) {
  d <- sim$d
  # many reporting draws, so that the class of a pair near a cut-off does not depend on chance
  old_seed <- get(".Random.seed", envir = .GlobalEnv)          # remember the random stream
  on.exit(assign(".Random.seed", old_seed, envir = .GlobalEnv))   # later steps draw exactly as before
  set.seed(505)
  n_tip <- 400000
  # Option A: one matrix of draws; Option B: the 20,000 draws of the simulation if memory is short
  p <- tryCatch(sapply(seq_len(nrow(d)), function(i)
    rbeta(n_tip, d$mi_reported[i] + 0.5, d$mi_total[i] - d$mi_reported[i] + 0.5)),
    error = function(e) sim$p)
  cr <- d$count / sim$wy
  ord <- order(-cr)                                            # sectors from highest to lowest rate
  idx <- CJ(a = seq_along(ord), b = seq_along(ord))[a < b]
  out <- idx[, {
    i <- ord[a]; j <- ord[b]                                   # i has the higher reported rate
    ratio_draw <- p[, j] / p[, i]
    thr <- cr[j] / cr[i]                                       # order flips below this ratio
    .(outcome = outcome, higher = d$sector[i], lower = d$sector[j],
      crude_rate_ratio = round(cr[i] / cr[j], 2),
      tipping_ratio    = round(thr, 3),
      michigan_ratio   = round(d$mi_compliance[j] / d$mi_compliance[i], 3),
      ratio_lo         = round(quantile(ratio_draw, 0.025), 3),
      ratio_hi         = round(quantile(ratio_draw, 0.975), 3),
      p_flip           = round(mean(ratio_draw < thr), 4))
  }, by = .(a, b)]
  out[, c("a", "b") := NULL]
  out[, verdict := ifelse(p_flip >= 0.95, "reversed",
                   ifelse(p_flip <= 0.05, "robust", "uncertain"))]
  out[order(-p_flip)]
}

set.seed(2026)                                                 # reproducible draws
sim_amp  <- sim_outcome(dat_amp)
sim_hosp <- sim_outcome(dat_hosp)

rank5 <- rbind(summ_rank(sim_amp,  sim_amp$rate0,  "amputation",      "equal_reporting"),
               summ_rank(sim_amp,  sim_amp$rate1,  "amputation",      "michigan"),
               summ_rank(sim_hosp, sim_hosp$rate0, "hospitalization", "equal_reporting"),
               summ_rank(sim_hosp, sim_hosp$rate1, "hospitalization", "michigan"))
rank5[, rank_width := rank_hi - rank_lo]

tip_amp  <- tip_outcome(sim_amp,  "amputation")
tip_hosp <- tip_outcome(sim_hosp, "hospitalization")
verdict5 <- rbind(tip_amp, tip_hosp)[, .N, by = .(outcome, verdict)][order(outcome, verdict)]

# largest reporting gap seen in Michigan (ratio of highest to lowest compliance)
gap5 <- rbind(
  sim_amp$d[,  .(outcome = "amputation",      sectors = .N,
                 max_compliance = max(mi_compliance), min_compliance = min(mi_compliance),
                 g_observed = round(max(mi_compliance) / min(mi_compliance), 2))],
  sim_hosp$d[, .(outcome = "hospitalization", sectors = .N,
                 max_compliance = max(mi_compliance), min_compliance = min(mi_compliance),
                 g_observed = round(max(mi_compliance) / min(mi_compliance), 2))])

# do the two outcomes tell the same story? (sectors present in both analyses)
common <- merge(rank5[outcome == "amputation" & scenario == "michigan",
                      .(sector, amp_crude = crude_rank, amp_adj = rank_med)],
                rank5[outcome == "hospitalization" & scenario == "michigan",
                      .(sector, hosp_crude = crude_rank, hosp_adj = rank_med)], by = "sector")
agree5 <- data.table(
  comparison = c("amputation: crude vs adjusted", "hospitalization: crude vs adjusted",
                 "crude: amputation vs hospitalization", "adjusted: amputation vs hospitalization"),
  spearman = round(c(cor(common$amp_crude,  common$amp_adj,   method = "spearman"),
                     cor(common$hosp_crude, common$hosp_adj,  method = "spearman"),
                     cor(common$amp_crude,  common$hosp_crude, method = "spearman"),
                     cor(common$amp_adj,    common$hosp_adj,  method = "spearman")), 3),
  n_sectors = nrow(common))

# ---------------- step05C : agriculture exposure sensitivity -----------------
# Covered employment may miss farm workers: multiply agricultural exposure by a factor.

mult_grid <- c(1, 1.5, 2, 2.5, 3, 4, 6, 8, 10)
ag_sens <- rbindlist(lapply(c("amputation", "hospitalization"), function(oc) {
  d_all <- if (oc == "amputation") dat_amp else dat_hosp
  rbindlist(lapply(mult_grid, function(m) {
    s  <- sim_outcome(d_all, ag_mult = m)
    rk <- row_ranks(s$rate1)
    ia <- which(s$d$sector == "11"); im <- which(s$d$sector == "31-33")
    data.table(outcome = oc, ag_exposure_multiplier = m,
               ag_rate_med   = round(median(s$rate1[, ia]), 2),              # corrected agriculture rate
               mfg_rate_med  = round(median(s$rate1[, im]), 2),              # corrected manufacturing rate
               p_ag_above_mfg = round(mean(s$rate1[, ia] > s$rate1[, im]), 4),
