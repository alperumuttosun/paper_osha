# Pearson dispersion of annual counts: 1 = Poisson, larger = more variable than Poisson
disp_one <- function(y, e) {
  tt  <- seq_along(y)
  mu0 <- sum(y) / sum(e) * e                                    # constant rate
  phi0 <- sum((y - mu0)^2 / mu0) / (length(y) - 1)
  # Option A: Poisson regression with a linear time trend
  fit <- tryCatch(suppressWarnings(glm(y ~ tt, family = poisson, offset = log(e))),
                  error = function(err) NULL)
  if (!is.null(fit) && isTRUE(fit$converged)) {
    mu1 <- fitted(fit)
  } else {
    # Option B: trend fitted by least squares on the log rate
    lr  <- log((y + 0.5) / e)
    mu1 <- exp(fitted(lm(lr ~ tt))) * e
    mu1 <- mu1 * sum(y) / sum(mu1)                              # same total as observed
  }
  phi1 <- sum((y - mu1)^2 / mu1) / (length(y) - 2)
  c(phi_constant = phi0, phi_trend = phi1)
}
