# exact Poisson limits for a rate (count / exposure)
pois_lo <- function(x, e) ifelse(x == 0, 0, qchisq(0.025, 2 * x) / 2) / e
pois_hi <- function(x, e) qchisq(0.975, 2 * (x + 1)) / 2 / e

# build a rate table for one industry level
make_rates <- function(sir_dt, by_col, q_dt) {
  num <- sir_dt[, .(reports = .N, amp = sum(any_amp), hosp = sum(any_hosp)), by = c(by_col)]
  setnames(num, by_col, "industry")
  den <- q_dt[, .(worker_years  = sum(emp_ok, na.rm = TRUE),              # employment summed over state-years
                  cells         = .N,
                  cells_missing = sum(is.na(emp_ok))),
              by = .(industry = industry_code)]
  out <- merge(num, den, by = "industry", all.x = TRUE)
  out[, amp_rate  := 1e5 * amp  / worker_years]                # amputations per 100,000 worker-years
  out[, amp_lo    := 1e5 * pois_lo(amp, worker_years)]
  out[, amp_hi    := 1e5 * pois_hi(amp, worker_years)]
  out[, hosp_rate := 1e5 * hosp / worker_years]                # hospitalizations per 100,000 worker-years
  out[, amp_rank  := frank(-amp_rate,  ties.method = "min", na.last = "keep")]
