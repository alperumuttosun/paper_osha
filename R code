# ---------------- step09A : hierarchical reporting model ---------------------
# Sector probabilities share a common Beta(a, b) distribution; a and b are estimated
# from all sectors, and each sector estimate is pulled towards the common mean.

bb_fit <- function(r, n) {
  # Option A: maximum likelihood of the beta-binomial model
  nll <- function(th) {
    a <- exp(th[1]); b <- exp(th[2])
    -sum(lbeta(r + a, n - r + b) - lbeta(a, b))
  }
  o <- tryCatch(optim(c(0, 0), nll, method = "Nelder-Mead", control = list(maxit = 2000)),
                error = function(e) NULL)
  if (!is.null(o) && o$convergence == 0) {
    return(list(a = exp(o$par[1]), b = exp(o$par[2]), method = "maximum likelihood"))
  }
  # Option B: method of moments on the observed proportions
  ph <- r / n; m <- mean(ph); v <- var(ph)
  k  <- max(m * (1 - m) / v - 1, 0.5)                          # prior sample size
  list(a = m * k, b = (1 - m) * k, method = "moments")
}

eb_table <- function(d, label) {
  f <- bb_fit(d$mi_reported, d$mi_total)
  data.table(set = label, sector = d$sector, name = sec_names[d$sector],
             mi_total = d$mi_total, mi_reported = d$mi_reported,
             raw = round(d$mi_reported / d$mi_total, 3),
             hierarchical = round((d$mi_reported + f$a) / (d$mi_total + f$a + f$b), 3),
             weight_own_data = round(d$mi_total / (d$mi_total + f$a + f$b), 3),
             prior_a = round(f$a, 2), prior_b = round(f$b, 2),
             prior_mean = round(f$a / (f$a + f$b), 3), method = f$method)
}
